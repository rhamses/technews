# Technews environment variables
#
# Copy this file to `.env` (git-ignored) and fill in the values you need.
# Not every command needs every variable — see the grouping below.
#
#   npm run content:pull / content:push  -> Cloudflare account + R2 keys
#   npm run ingest                        -> no variables (fetches public RSS feeds)
#   npm run build                         -> CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID
#   astro dev / astro preview             -> CLOUDFLARE_API_TOKEN (the AI binding is remote)
#
# Worker runtime secrets (VAPID_*, PUSH_NOTIFY_SECRET) are consumed by the
# deployed Worker. For local Wrangler runs put them in `.dev.vars`; in
# production set them with `wrangler secret put <NAME>`. They are listed here
# so the full set of required values is documented in one place.

# --- Cloudflare account / API ---
# Account ID that owns the Worker, R2 bucket, D1 database, and KV namespace.
CLOUDFLARE_ACCOUNT_ID=
# API token with Workers + Workers AI permissions. Required to run
# `astro dev` / `astro preview` (Workers AI is a remote binding) and to
# deploy the Worker with Wrangler.
CLOUDFLARE_API_TOKEN=

# --- R2 (article corpus sync: content:pull / content:push) ---
# S3-compatible access key pair for the content bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: override the bucket name (default: technews-content).
# R2_BUCKET=technews-content
# Optional: number of parallel upload/download workers (default: 24).
# R2_SYNC_CONCURRENCY=24

# --- Web Push (Worker runtime secrets) ---
# VAPID key pair used to sign Web Push messages.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact URI advertised to push services
# (default: mailto:technews@amb1.io).
# VAPID_SUBJECT=mailto:you@example.com
# Shared secret required to authorize POST /api/push/notify.
PUSH_NOTIFY_SECRET=
