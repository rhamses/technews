---
export const prerender = false;

import { Icon } from "astro-icon/components";
import ArticleHeader from "../../components/ArticleHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { enhanceArticleHtml } from "../../lib/enhance-article-html";
import { loadOrReextractArticle } from "../../lib/read-later";

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/reading-list/");
}

const article = await loadOrReextractArticle(id);
if (!article) {
  return Astro.redirect("/reading-list/");
}

const enhancedHtml = article.contentHtml
  ? await enhanceArticleHtml(article.contentHtml)
  : null;

const pubDate = new Date(article.pubDate);
const description =
  article.summary ||
  `Article from ${article.site_name}, saved to your reading list.`;
---

<BaseLayout
  title={article.title}
  description={description}
  canonical={article.sourceUrl}
>
  <article
    class="article-page"
    data-article
    data-article-id={article.id}
    x-data
    x-init={`$store.reads.observeEnd(${JSON.stringify(article.id)}, $refs.readEnd)`}
  >
    <ArticleHeader
      articleId={article.id}
      title={article.title}
      siteName={article.site_name}
      author={article.author}
      pubDate={pubDate}
      backHref="/reading-list/"
      backLabel="Reading list"
    />

    {
      enhancedHtml ? (
        <div
          class="article-body"
          data-article-body
          set:html={enhancedHtml}
          @click={`
            const trigger = $event.target.closest('.article-lightbox-trigger');
            if (trigger) {
              $event.preventDefault();
              $store.lightbox.open(trigger.getAttribute('data-lightbox-src'));
            }
          `}
        />
      ) : (
        <div class="article-body" data-article-body>
          <p>No content available for this article.</p>
        </div>
      )
    }

    <a class="original-link" href={article.sourceUrl} rel="noopener noreferrer">
      Read original
      <Icon name="lucide:external-link" />
    </a>

    <div class="article-read-end" x-ref="readEnd" aria-hidden="true"></div>
  </article>
</BaseLayout>

<script>
  const articleRoot = document.querySelector("[data-article]");
  if (articleRoot) {
    const titleEl = articleRoot.querySelector("[data-article-title]");
    const bodyEl = articleRoot.querySelector("[data-article-body]");
    const langSelect = articleRoot.querySelector<HTMLSelectElement>("[data-lang-select]");
    const translateBtn = articleRoot.querySelector<HTMLButtonElement>("[data-translate-btn]");
    const originalBtn = articleRoot.querySelector<HTMLButtonElement>("[data-original-btn]");
    const statusEl = articleRoot.querySelector("[data-translate-status]");

    if (bodyEl) {
      for (const img of bodyEl.querySelectorAll("img")) {
        if (img.closest("button.article-lightbox-trigger")) {
          continue;
        }
        const src =
          img.getAttribute("src")?.trim() ||
          img.getAttribute("srcset")?.split(",")?.at(-1)?.trim().split(/\s+/)[0];
        if (!src || src.startsWith("data:")) {
          continue;
        }
        const button = document.createElement("button");
        button.type = "button";
        button.className = "article-lightbox-trigger";
        button.setAttribute("data-lightbox-src", src);
        button.setAttribute(
          "aria-label",
          img.getAttribute("alt")?.trim() || "View larger image",
        );
        const parentLink = img.closest("a");
        if (parentLink && parentLink.querySelectorAll("img").length === 1) {
          parentLink.replaceWith(button);
        } else {
          img.replaceWith(button);
        }
        button.appendChild(img);
      }
    }

    if (titleEl && bodyEl && langSelect && translateBtn && originalBtn && statusEl) {
      const originalTitle = titleEl.textContent || "";
      const originalBody = bodyEl.innerHTML;

      function setBusy(busy: boolean) {
        translateBtn.disabled = busy;
        langSelect.disabled = busy;
        statusEl.textContent = busy ? "Translating…" : "";
      }

      translateBtn.addEventListener("click", async () => {
        const targetLang = langSelect.value;
        const plainBody = bodyEl.innerText.trim();
        if (!plainBody) {
          statusEl.textContent = "Nothing to translate.";
          return;
        }

        setBusy(true);
        try {
          const response = await fetch("/api/translate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              title: originalTitle,
              text: plainBody,
              target_lang: targetLang,
            }),
          });

          const payload = await response.json();
          if (!response.ok) {
            throw new Error(payload.error || "Translation failed.");
          }

          const escapeHtml = (value: string) =>
            value
              .replaceAll("&", "&amp;")
              .replaceAll("<", "&lt;")
              .replaceAll(">", "&gt;")
              .replaceAll('"', "&quot;");

          titleEl.textContent = payload.title || originalTitle;
          bodyEl.innerHTML = String(payload.text || "")
            .split(/\n+/)
            .filter(Boolean)
            .map((paragraph: string) => `<p>${escapeHtml(paragraph)}</p>`)
            .join("");
          originalBtn.hidden = false;
          statusEl.textContent = `Translated to ${langSelect.selectedOptions[0]?.label || targetLang}.`;
        } catch (error) {
          statusEl.textContent =
            error instanceof Error ? error.message : "Translation failed.";
        } finally {
          setBusy(false);
        }
      });

      originalBtn.addEventListener("click", () => {
        titleEl.textContent = originalTitle;
        bodyEl.innerHTML = originalBody;
        originalBtn.hidden = true;
        statusEl.textContent = "";
      });
    }
  }
</script>
