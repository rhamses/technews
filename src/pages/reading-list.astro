---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  estimateReadingMinutes,
  formatReadingTime,
} from "../lib/reading-time";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const feedItems = articles.map((article) => ({
  id: article.id,
  title: article.data.title,
  site_name: article.data.site_name,
  category: article.data.category,
  readingTime: formatReadingTime(
    estimateReadingMinutes([
      article.data.contentHtml,
      article.data.summary,
      article.body,
    ]),
  ),
  pubDate: article.data.pubDate.toISOString(),
  url: `/article/${article.id}/`,
  kind: "feed" as const,
}));

const feedPayload = JSON.stringify(feedItems).replace(/</g, "\\u003c");
---

<BaseLayout
  title="My reading list · Technews"
  description="Articles you saved for later."
>
  <script
    type="application/json"
    id="technews-feed-data"
    set:html={feedPayload}
  ></script>

  <div class="home-feed" x-data="readingList">
    <section class="hero">
      <div class="hero-row">
        <p>Your saved articles, ready when you are.</p>
        <div class="feed-controls">
          <button
            type="button"
            class="category-trigger"
            :disabled="pasteBusy"
            @click="openPasteModal()"
          >
            Colar URL
          </button>
        </div>
      </div>
    </section>

    <div
      class="paste-url-modal"
      x-show="pasteModalOpen"
      x-cloak
      x-transition.opacity.duration.150ms
      @keydown.escape.window="closePasteModal()"
      role="dialog"
      aria-modal="true"
      aria-labelledby="paste-url-title"
    >
      <button
        type="button"
        class="paste-url-backdrop"
        aria-label="Close"
        @click="closePasteModal()"
      ></button>
      <div class="paste-url-panel" @click.stop>
        <h2 id="paste-url-title">Add article URL</h2>
        <p class="paste-url-copy">
          Paste a link to fetch and save it to your reading list.
        </p>
        <form class="paste-url-form" @submit.prevent="submitPasteUrl()">
          <label class="paste-url-label" for="paste-url-input">Article URL</label>
          <input
            id="paste-url-input"
            class="paste-url-input"
            type="url"
            name="url"
            inputmode="url"
            autocomplete="url"
            placeholder="https://…"
            x-model="pasteUrlValue"
            x-ref="pasteInput"
            :disabled="pasteBusy"
            required
          />
          <p
            class="paste-url-status"
            x-show="pasteStatus"
            x-text="pasteStatus"
            aria-live="polite"
          ></p>
          <div class="paste-url-actions">
            <button
              type="button"
              class="paste-url-cancel"
              :disabled="pasteBusy"
              @click="closePasteModal()"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="paste-url-submit"
              :disabled="pasteBusy || !pasteUrlValue.trim()"
            >
              <span x-text="pasteBusy ? 'Processing…' : 'Add to list'"
                >Add to list</span
              >
            </button>
          </div>
        </form>
      </div>
    </div>

    <template x-if="listedArticles.length === 0">
      <p class="empty">
        Nothing saved yet. Tap the bookmark on any article card, or paste a URL
        to read later.
      </p>
    </template>

    <template x-if="listedArticles.length > 0">
      <ol class="article-list">
        <template x-for="article in listedArticles" :key="article.id">
          <li
            class="article-card"
            :class="{
              'is-read': $store.reads.isRead(article.id),
              'is-saved': true,
            }"
          >
            <button
              type="button"
              class="article-save-toggle"
              title="Remove from reading list"
              aria-label="Remove from reading list"
              aria-pressed="true"
              @click.stop="removeArticle(article)"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M6 3.75A1.75 1.75 0 0 1 7.75 2h8.5A1.75 1.75 0 0 1 18 3.75v16.09a.75.75 0 0 1-1.2.6L12 16.56l-4.8 3.88a.75.75 0 0 1-1.2-.6V3.75Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </button>
            <label
              class="article-read-toggle"
              title="Mark as read"
              @click.stop
            >
              <input
                type="checkbox"
                :checked="$store.reads.isRead(article.id)"
                @click.stop
                @change="$store.reads.setRead(article.id, $event.target.checked)"
                aria-label="Mark as read"
              />
            </label>
            <a :href="article.url">
              <span class="article-title" x-text="article.title"></span>
              <span class="meta">
                <span x-text="article.site_name"></span>
                <span x-text="article.category"></span>
                <span x-text="article.readingTime"></span>
                <time
                  :datetime="article.pubDate"
                  x-text="formatDate(article.pubDate)"
                ></time>
              </span>
            </a>
          </li>
        </template>
      </ol>
    </template>
  </div>
</BaseLayout>
