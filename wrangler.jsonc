{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "technews",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/technews", "/technews/*"]
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "technews.rhams.es",
			"custom_domain": true
		},
		{
			"pattern": "rhams.es/technews*",
			"zone_name": "rhams.es"
		}
	],
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "34de0ddc159a4feaa1b94a4727a09e6e"
		},
		{
			"binding": "ARTICLE_CACHE",
			"id": "306d24081f1d405c8fa35950c7804e74"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "technews",
			"database_id": "eb60ba73-4d2c-4ea7-b7ac-7257ef2adad9",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "CONTENT",
			"bucket_name": "technews-content"
		}
	]
}
